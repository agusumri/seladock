<Window x:Class="SelaDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SelaDock.ViewModel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Title="SelaDock">

    <Window.Resources>
        <!-- Shared style for the square system/Start/tray buttons on the dock. -->
        <Style x:Key="SysButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <!-- Outer grid fills the reserved strip; the dock pill is centred and slides on hover. -->
    <Grid x:Name="Root">
        <!-- Hides the frame overhang of maximized windows at the top edge of the reserved strip.
             Declared first so the pill and its shadow draw above it. Toggled in code-behind. -->
        <Border x:Name="EdgeMask"
                VerticalAlignment="Top"
                Height="8"
                Background="{StaticResource DockEdgeMask}"
                IsHitTestVisible="False" />

        <Border x:Name="Pill"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Padding="6,5"
                Background="{StaticResource DockBg}"
                BorderBrush="{StaticResource DockBorder}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillSlide" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal">

                <!-- Start button -->
                <Border x:Name="StartBtn" Style="{StaticResource SysButton}"
                        Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                        MouseLeftButtonUp="Start_Click" ToolTip="Start">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource ClockText}"
                               FontSize="{Binding GlyphSize}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Width="1" Margin="4,6" Background="{StaticResource Separator}" />

                <!-- Pinned + running app buttons -->
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DockItem}">
                            <Grid Margin="1,0" Cursor="Hand"
                                  Background="Transparent"
                                  MouseLeftButtonDown="App_MouseDown"
                                  MouseMove="App_MouseMove"
                                  MouseLeftButtonUp="App_Click"
                                  MouseRightButtonUp="App_RightClick"
                                  ToolTip="{Binding Title}"
                                  RenderTransformOrigin="0.5,1">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <StackPanel>
                                    <Border x:Name="Plate"
                                            Width="{Binding DataContext.PlateSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding DataContext.PlateSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CornerRadius="12"
                                            Background="Transparent" VerticalAlignment="Bottom">
                                        <Image Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Ellipse x:Name="Dot" Width="4" Height="4" Margin="0,2,0,0"
                                             HorizontalAlignment="Center"
                                             Fill="{StaticResource RunningDot}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHighlight}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ActiveDot}" />
                                    <Setter TargetName="Dot" Property="Width" Value="5" />
                                    <Setter TargetName="Dot" Property="Height" Value="5" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.25" Duration="0:0:0.13" />
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.25" Duration="0:0:0.13" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Plate" Property="Background" Value="{StaticResource DockHighlight}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Width="1" Margin="4,6" Background="{StaticResource Separator}" />

                <!-- Hidden tray overflow ("^") -> opens the real Windows tray overflow -->
                <Border x:Name="TrayBtn" Style="{StaticResource SysButton}"
                        Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                        MouseLeftButtonUp="Tray_Click" ToolTip="Show hidden icons">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource ClockSub}"
                               FontSize="{Binding GlyphSize}" RenderTransformOrigin="0.5,0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="180" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- System indicators: network / volume / battery -->
                <Border x:Name="NetBtn" Style="{StaticResource SysButton}"
                        Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                        MouseLeftButtonUp="Net_Click" ToolTip="{Binding Sys.NetworkTip}">
                    <TextBlock x:Name="NetGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource ClockText}" FontSize="{Binding GlyphSize}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="VolBtn" Style="{StaticResource SysButton}"
                        Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                        MouseLeftButtonUp="Vol_Click" ToolTip="{Binding Sys.VolumeTip}">
                    <TextBlock x:Name="VolGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource ClockText}" FontSize="{Binding GlyphSize}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="BattBtn" Style="{StaticResource SysButton}"
                        Width="{Binding ButtonSize}" Height="{Binding ButtonSize}"
                        MouseLeftButtonUp="Batt_Click" ToolTip="{Binding Sys.BatteryTip}">
                    <TextBlock x:Name="BattGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource ClockText}" FontSize="{Binding GlyphSize}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Clock (click -> calendar) -->
                <Border x:Name="ClockBtn" Style="{StaticResource SysButton}"
                        Padding="6,0" MouseLeftButtonUp="Clock_Click" ToolTip="Calendar">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTime" Foreground="{StaticResource ClockText}"
                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="ClockDate" Foreground="{StaticResource ClockSub}"
                                   FontSize="10" TextAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
