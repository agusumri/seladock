<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray NotifyIcon; its namespaces are removed from implicit
         usings so they don't clash with the WPF types of the same name. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>SelaDock</AssemblyName>
    <RootNamespace>SelaDock</RootNamespace>
    <Product>SelaDock</Product>
    <AssemblyTitle>SelaDock</AssemblyTitle>
    <Company>Sela</Company>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon Condition="Exists('Assets\SelaDock.ico')">Assets\SelaDock.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
